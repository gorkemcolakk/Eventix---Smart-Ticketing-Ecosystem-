# SMTP Sunucu Ayarlari (Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Eventix Ticket

# Frontend URL
FRONTEND_URL=http://localhost:5002

# Güvenlik (Production'da güçlü bir key üretin!)
SECRET_KEY=generate-a-strong-random-key-here
DEBUG=false
CORS_ORIGINS=http://localhost:5002,http://127.0.0.1:5002

# Turso Cloud DB Settings (isteğe bağlı, yoksa local SQLite kullanılır)
# TURSO_DB_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token

# İletişim formu alıcı email
CONTACT_TO=your-email@gmail.com
